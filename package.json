{
  "name": "@sprit/anf",
  "description": "数值格式化工具",
  "license": "MIT",
  "version": "1.0.1",
  "scripts": {
    "start": "dumi dev",
    "docs:build": "NODE_OPTIONS=--openssl-legacy-provider dumi build",
    "docs:deploy": "gh-pages -d docs-dist",
    "build": "father build",
    "deploy": "npm run docs:build && npm run docs:deploy",
    "prettier": "prettier --write \"**/*.{js,jsx,tsx,ts,less,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "test",
    "logo.png",
    "README.md",
    "pageage.json"
  ],
  "homepage": "https://fantian007.github.io/anf",
  "repository": {
    "type": "git",
    "url": "https://github.com/fantian007/anf.git"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "typings": "dist/esm/index.d.ts",
  "author": {
    "name": "赵永盛",
    "email": "1562743134@qq.com"
  },
  "contributors": [
    "1562743134@qq.com"
  ],
  "maintainers": [
    "1562743134@qq.com"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "readme": "README.md",
  "engines": {
    "node": ">=10"
  },
  "size-limit": [
    {
      "path": "dist/anf.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/anf.esm.js",
      "limit": "10 KB"
    }
  ],
  "dependencies": {
    "bignumber.js": "^9.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.15.1",
    "@testing-library/react": "^13.0.0",
    "@types/jest": "^27.0.3",
    "@umijs/fabric": "^2.8.1",
    "@umijs/test": "^3.0.5",
    "dumi": "^1.1.0",
    "father": "^4.0.0-rc.2",
    "gh-pages": "^4.0.0",
    "lint-staged": "^10.0.7",
    "prettier": "^2.2.1",
    "react": "^18.0.0",
    "vitest": "^4.1.6",
    "yorkie": "^2.0.0"
  }
}
